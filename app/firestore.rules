rules_version = '2';

// AnimeWear Ledger — who can read and write what.
// Paste this whole file into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() {
      return signedIn() && exists(userDoc()) ? get(userDoc()).data.role : 'none';
    }
    function is(roles) { return role() in roles; }
    function ownerUid() { return get(/databases/$(database)/documents/config/app).data.ownerUid; }

    // Shared settings. Created once by the very first account (the owner).
    match /config/app {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(userDoc()).data.role == 'owner';
      allow update: if is(['owner'])
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || is(['owner', 'manager', 'seller', 'accountant']);
      // A new account starts with no access. Only the very first account may
      // make itself owner, in the same write that creates config/app.
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'pending' ||
        (request.resource.data.role == 'owner'
          && !exists(/databases/$(database)/documents/config/app)
          && getAfter(/databases/$(database)/documents/config/app).data.ownerUid == uid)
      );
      // The owner sets everyone else's role; people may edit their own name only.
      allow update: if (is(['owner']) && uid != ownerUid()
                        && request.resource.data.role in ['owner', 'manager', 'seller', 'accountant', 'pending'])
                    || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /sales/{id} {
      allow read: if is(['owner', 'manager', 'seller', 'accountant']);
      allow create: if is(['owner', 'manager', 'seller']) && request.resource.data.by == request.auth.uid;
      allow update, delete: if is(['owner', 'manager']);
    }

    match /payments/{id} {
      allow read: if is(['owner', 'manager', 'accountant']);
      allow write: if is(['owner', 'manager']);
    }

    match /capital/{id} {
      allow read: if is(['owner', 'manager', 'accountant']);
      allow write: if is(['owner']);
    }
  }
}
