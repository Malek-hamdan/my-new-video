<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.5"
                android:centerY="0.30"
                android:startColor="#448A6BFF"
                android:centerColor="#1A8A6BFF"
                android:endColor="#000B0B12" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="360dp"
                android:centerX="0.15"
                android:centerY="0.9"
                android:startColor="#33FF6B8B"
                android:endColor="#000B0B12" />
        </shape>
    </item>
</layer-list>
